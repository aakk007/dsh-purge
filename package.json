        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/aakk007/dsh-purge/archive/refs/tags/v1.1.74.tar.gz",
      "zip": "https://github.com/aakk007/dsh-purge/archive/refs/tags/v1.1.74.zip",
