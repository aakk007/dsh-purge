    "check:maintenance-client": "node scripts/build-maintenance-client.mjs --check",
    "test:maintenance": "node --test tests/maintenance.test.mjs tests/update-integrity.test.mjs tests/update-zip.test.mjs tests/migration-backup.test.mjs tests/preset-adapter.test.mjs tests/profile-source.test.mjs",
